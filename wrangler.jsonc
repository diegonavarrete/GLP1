{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "glp1-cl",
  "main": "src/index.js",
  "compatibility_date": "2026-05-01",
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  }
}
